# Environment configuration for Kafka SSL
# Для интеграционных тестов

KAFKA_BOOTSTRAP_SERVERS=localhost:9093
KAFKA_SSL_KEYSTORE_LOCATION=kafka-ssl/kafka.keystore.jks
KAFKA_SSL_KEYSTORE_PASSWORD=changeit
KAFKA_SSL_KEY_PASSWORD=changeit
KAFKA_SSL_TRUSTSTORE_LOCATION=kafka-ssl/kafka.truststore.jks
KAFKA_SSL_TRUSTSTORE_PASSWORD=changeit
KAFKA_SECURITY_PROTOCOL=SSL

# Demo topics
OPENCODE_PROMPTS_TOPIC=opencode.prompts
OPENCODE_RESPONSES_TOPIC=opencode.responses
OPENCODE_ERRORS_TOPIC=opencode.errors
OPENCODE_DLQ_TOPIC=opencode.dlq
OPENCODE_DLQ_GROUP=opencode-dlq-group