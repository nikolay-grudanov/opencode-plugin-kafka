# Kafka Broker Configuration
# Required
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=opencode-kafka-plugin
KAFKA_GROUP_ID=opencode-consumer-group

# SSL Configuration (optional)
# Enable SSL for production
KAFKA_SSL=false
# PEM certificate paths (when KAFKA_SSL=true)
# KAFKA_SSL_CA=./kafka-ssl/ca.pem
# KAFKA_SSL_CERT=./kafka-ssl/client.pem
# KAFKA_SSL_KEY=./kafka-ssl/client-key.pem

# SASL Authentication (optional)
# KAFKA_SASL_MECHANISM=plain
# KAFKA_USERNAME=
# KAFKA_PASSWORD=

# Dead Letter Queue (optional)
# KAFKA_DLQ_TOPIC=opencode.dlq

# Router Configuration (optional)
# KAFKA_ROUTER_CONFIG=.opencode/kafka-router.json

# Tombstone Handling (optional)
# KAFKA_IGNORE_TOMBSTONES=false